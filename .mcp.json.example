{
  "_comment": "Project MCP servers for Claude Code: copy to .mcp.json (gitignored). Keep this template free of local paths and credentials. Define local stdio and approved remote HTTP servers here; secrets via env, never inline. Copy .cursor/mcp.example.json -> .cursor/mcp.json (gitignored) for Cursor. Naming convention: <scope>-<ro|rw>-<purpose> (ro/read = read-only, rw/write = write-capable). Prefer a compact search+dispatch surface over many raw tools.",
  "mcpServers": {
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp",
      "type": "http"
    },
    "vexlum": {
      "_comment": "Pipeline search/resolve/execute entry point (image-scoring-pipeline docs/technical/VEXLUM_MCP.md). Build first: cd image-scoring-pipeline/mcp-server && npm ci && npm run build.",
      "side_effects": "write-capable",
      "approval_required": true,
      "approval_note": "execute can run pipeline actions; destructive ones also need VEXLUM_ALLOW_ELEVATED=1 on this entry.",
      "type": "stdio",
      "command": "node",
      "args": [
        "${IMAGE_SCORING_PIPELINE_DIR:-../image-scoring-pipeline}/mcp-server/dist/vexlum.js"
      ]
    },
    "driftara": {
      "_comment": "Gallery search/resolve/execute entry point (image-scoring-gallery docs/technical/DRIFTARA_MCP.md). Build first: cd image-scoring-gallery/mcp-server && npm ci && npm run build.",
      "side_effects": "write-capable",
      "approval_required": true,
      "approval_note": "execute can run gallery actions; write tiers need confirmation, and elevated ones also need DRIFTARA_ALLOW_ELEVATED=1 in the gallery app's environment.",
      "type": "stdio",
      "command": "node",
      "args": [
        "${IMAGE_SCORING_GALLERY_DIR:-../image-scoring-gallery}/mcp-server/dist/driftara.js"
      ]
    }
  },
  "_examples": {
    "proj-ro-fff": {
      "_comment": "Optional local stdio read-only file search — https://github.com/dmtrKovalenko/fff . Tools: ffgrep, fffind, fff-multi-grep",
      "side_effects": "read-only",
      "command": "fff-mcp",
      "args": [],
      "env": {
        "WORKSPACE_ROOT": "${workspaceFolder}"
      }
    },
    "proj-ro-graphify": {
      "_comment": "Optional local stdio read-only knowledge graph — https://github.com/Graphify-Labs/graphify . Requires: uv tool install \"graphifyy[mcp]\"; build graphify-out/graph.json first (graphify .). Tools: query_graph, get_node, get_neighbors, shortest_path, …",
      "side_effects": "read-only",
      "command": "graphify-mcp",
      "args": [
        "graphify-out/graph.json"
      ],
      "env": {
        "WORKSPACE_ROOT": "${workspaceFolder}"
      }
    },
    "proj-ro-docs": {
      "_comment": "Example remote HTTP read-only MCP server. Remote examples are disabled by default; set enabled=true only after review.",
      "side_effects": "read-only",
      "enabled": false,
      "url": "https://mcp.example.com/docs",
      "headers": {
        "Authorization": "Bearer ${MCP_DOCS_TOKEN}"
      }
    },
    "proj-rw-issues": {
      "_comment": "Example remote HTTP write-capable MCP server. All auth uses env references only; write tools require human approval before side effects.",
      "side_effects": "write-capable",
      "approval_required": true,
      "approval_note": "Required before creating, updating, deleting, or dispatching issue tracker actions.",
      "enabled": false,
      "url": "https://mcp.example.com/issues",
      "headers": {
        "Authorization": "Bearer ${MCP_ISSUES_TOKEN}"
      }
    }
  }
}
